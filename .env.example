# Firebase web config (these are public identifiers, not secrets; access is controlled by firestore.rules)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id
# reCAPTCHA v3 site key for Firebase App Check (public). Leave empty until set up.
VITE_RECAPTCHA_SITE_KEY=
# Cloudinary unsigned upload preset limited to images in one folder (public names, not secrets)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Local development only: talk to the Firebase emulators instead of a real project
VITE_USE_EMULATORS=false
